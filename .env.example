# Vorlage. Die echten Werte liegen ausschliesslich in Vercel (Projekt auan-nfqo).
# Diese Datei enthaelt niemals Werte, nur Namen.

DATABASE_URL=            # Neon Postgres Connection String
BLOB_READ_WRITE_TOKEN=   # Vercel Blob
OPENAI_API_KEY=          # Text + Whisper
OXOMI_PORTAL=            # Portal-ID
OXOMI_USER=              # technischer Benutzer
OXOMI_SECRET=            # Shared Secret fuer die Token-Erzeugung
APP_SECRET=              # Session-Signierung, schuetzt auch die /dev-Routen

# Optional, nur falls OXOMI unter einer abweichenden Adresse erreichbar ist:
# OXOMI_BASE_URL=https://oxomi.com
